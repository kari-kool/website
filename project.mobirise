          "_name": "countres01",
          "_sourceTheme": "designerm4",
          "_customHTML": "<section class=\"counters1 counters\" group=\"Counters\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Cards Title\" name=\"showTitles\" checked>\n        <select title=\"Cards Count\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/team2-1920x1080.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row jc-e\">\n\n            <div class=\"col-lg-8 mb-5\" mbr-if=\"showTitle\">\n                <h2 class=\"title align-left mb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".title\"><b>What makes \n</b><img src=\"@PROJECT_PATH@/assets/images/logo-black.png\" alt=\"Kool Logo\" class=\"title-img\"><b> cool</b></h2>\n                <h3 class=\"title align-left mb-5 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".title\">We create content that people genuinely <b>see themselves reflected in.</b> From trends on TikTok to a full-on documentary.</h3>\n            </div>\n\n            <div class=\"col-lg-5\">\n                <div class=\"row\">\n                    <div class=\"card align-left mb-5 col-12 col-lg-6 col-md-6\">\n                        <div class=\"panel-item\">\n                            <div class=\"card-img\">\n                            </div>\n                            <div class=\"card-text\">\n                                <h4 class=\"mbr-content-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\"><div><b>End-to-end process</b><br>We help you with the creative strategy and also with content creation. No outsourcing or subcontracting here.</div></h4>\n\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card align-left mb-5 col-12 col-lg-6 col-md-6\" mbr-if=\"cardsAmount>1\">\n                        <div class=\"panel-item\">\n                            <div class=\"card-img\">\n                            </div>\n                            <div class=\"card-text\">\n                                <h4 class=\"mbr-content-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\"><b>We are always on</b><br>We make your brand position itself with constant content strategies, we are always on.<br><div><br></div></h4>\n\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card align-left mb-5 col-12 col-lg-6 col-md-6\" mbr-if=\"cardsAmount>2\">\n                        <div class=\"panel-item\">\n                            <div class=\"card-img\">\n                            </div>\n                            <div class=\"card-text\">\n                                <h4 class=\"mbr-content-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\"><b>UGC creators in LATAM<br></b>Pioneers in UGC strategies to create ads that really sell.&nbsp;</h4>\n\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card align-left mb-5 col-12 col-lg-6 col-md-6\" mbr-if=\"cardsAmount>3\">\n                        <div class=\"panel-item\">\n                            <div class=\"card-img\">\n                            </div>\n                            <div class=\"card-texts\">\n                                <h4 class=\"mbr-content-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\"><b>Storytelling</b><br>We tell kool stories with high-quality production.</h4>\n\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u4p1JddlhZ",
          "_anchor": "what-makes-kool-cool",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
