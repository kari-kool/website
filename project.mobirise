        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n<div class=\"container section\">\n    <div class=\"row\">\n        <div class=\"col-12 col-md-6 d-flex my-3 my-md-0\">\n            <div class=\"info\">\n                <h1 class=\"mbr-section-title\">The <a class=\"yellow-title\">K</a> in marketing is for <img src=\"@PROJECT_PATH@/assets/images/logo-yellow2.png\" alt=\"Kool Logo\" class=\"yellow-title-img\"></h1>\n                <p class=\"text-md\">We create <em>kool</em> and <em>relatable</em> content for your brand.</p>\n                <p class=\"text-md\">We innovate the way your brand speaks.</p>\n                 <div class=\"mbr-section-btn\"><a class=\"btn btn-lg btn-black-outline\" href=\"contact-us.html\">I want to be KOOL</a></div>\n                \n            </div>\n        </div>\n        <div class=\"col-12 col-md-6 animation\">\n            <div class=\"rail\">\n            <div class=\"imgs scroll-1\">\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video13.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video14.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video15.mp4\"></video>\n            </div>\n            <div class=\"imgs scroll-1\">\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video10.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video11.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video12.mp4\"></video>\n            </div>\n        </div>\n            <div class=\"rail\">\n            <div class=\"imgs scroll-2\">\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video1.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video2.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video3.mp4\"></video>\n            </div>\n            <div class=\"imgs scroll-2\">\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video4.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video5.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video6.mp4\"></video>\n            </div>\n        </div>\n            <div class=\"rail\">\n            <div class=\"imgs scroll-1\">\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video16.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video17.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video18.mp4\"></video>\n            </div>\n            <div class=\"imgs scroll-1\">\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video16.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video17.mp4\"></video>\n                <video autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://www.koolstudio.mx/assets/videos/video18.mp4\"></video>\n            </div>\n        </div>\n    </div>\n    </div>\n</div>",
          "_customCSS": "* {\n    font-family: 'Poppins', sans-serif;\n}\n\ndiv {\n\tdisplay:block;\n}\nvideo{\n\twidth:100%;\n\tpadding:.25rem;\n\tobject-fit: cover;\n\tborder-radius:16px;\n}\n\n.yellow-title{\n    color: #ffdf58;\n}\n\n.yellow-title-img {\n  width: 180px;\n  height: 50px;\n  margin-bottom:8px;\n  display: inline-block;\n  object-fit: contain;\n    object-fit: contain;\n}\n\n.section {\n  background-color: #ffffff; \n}\n\n.rail{\n\theight:200%;\n\twidth:33.3%;\n\tdisplay:inline-block;\n}\n.col-12{\n    display:flex;\n\tflex: 0 0 100%;\n    height: 600px;\n     justify-content: flex-end;\n}\n\n.animation{\n    overflow:hidden;\n}\n\n.row {\n    display: flex;\n    flex-wrap: wrap;\n    margin-right: -15px;\n    margin-left: -15px;\n}\n\n.container{\n    width: 100%;\n    padding-right: 15px;\n    padding-left: 15px;\n    margin-right: auto;\n    margin-left: auto;\n}\n\n.info{\n    padding-top: 5rem;\n}\n\n.d-flex{\n    display: flex !important;\n}\n\n.text-md {\n line-height: 28px;\n max-width: 500px;\n padding: 0 4rem 0 0;\n font-size:1.15rem;\n      \n  @media (max-width: 576px) {\n    margin-top: 0 !important;\n    padding-top: 0;\n    padding: 0;\n    text-align: center;\n  }\n}\n\n.mbr-section-title {\n  font-style: normal;\n  font-weight:900;\n  color: #131419;\n    font-size:4rem;\n    padding: 0 3.5rem 0 0;\n    \n     @media (max-width: 576px) {\n    padding: 0;\n    bottom: 0 !important;\n    padding-bottom: 0;\n    font-size:3rem;\n   text-align: center !important;\n  } \n    \n  @media (max-width: 868px) {\n    font-size:3rem;\n\n  } \n}\n\n.mbr-section-btn {\n  padding-bottom: 8rem;\n  @media (max-width: 576px) {\n    padding: 0;\n    padding-bottom: 2rem;\n    text-align: center !important;\n  }\n}\n\n/************animations************/\n.scroll-1{\n\tanimation: scroll-1 24s linear infinite;\n}\n\n@keyframes scroll-1 {\n  0% { transform: translateY(0); }\n  100% { transform: translateY(-100%); }\n}\n\n.scroll-2{\n\tanimation: scroll-2 24s linear infinite;\n}\n\n@keyframes scroll-2 {\n  0% { transform: translateY(-100%); }\n  100% { transform: translateY(0); }\n}\n\n\n.scroll-3{\n\tanimation: scroll-3 24s linear infinite;\n}\n\n@keyframes scroll-3 {\n  0% { transform: translateY(0); }\n  100% { transform: translateY(-100%); }\n}\n\n/************media************/\n\n\n@media (min-width: 1200px){\n     .animation {\n        height: 700px;\n    }\n    .container{\n        max-width: 1120px;\n    }\n}\n@media (min-width: 992px){\n    .col-md-6{\n        flex: 0 0 50%;\n        max-width: 50%;\n    }\n    .my-md-0{\n        margin-bottom: 0 !important;\n        margin-top: 0 !important;\n    }\n}\n\n@media (max-width:576px){\n    .animation{\n        height:650px;\n    }\n    \n}\n\n",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "designerm4",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_params": {},
          "_anchor": "the-k-in-mkt"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(@bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title-img": {
              "width": "160px",
              "height": "40px",
              "margin-bottom": "10px",
              "display": "inline-block",
              "object-fit": "contain"
            },
            "position": "relative",
            "overflow": "hidden",
            "svg": {
              "position": "absolute",
              "bottom": "-5.5rem",
              "left": "50%",
              "transform": "translate(-50%) scaleX(-2) scaleY(-1) rotate(-12deg)",
              "filter": "fliph",
              "animation": "wave2 5s ease-in-out infinite"
            },
            "@keyframes wave2": {
              "from": {
                "transform": "translate(-50%) scaleX(-2) scaleY(-1) rotate(-10deg)"
              },
              "50%": {
                "transform": "translate(-50%) scaleX(-2.2) scaleY(-1.1) rotate(-13deg)"
              },
              "to": {
                "transform": "translate(-50%) scaleX(-2) scaleY(-1) rotate(-10deg)"
              }
            },
            "#e12_areaS3": {
              "fill": "@svg1 !important"
            },
            "#e19_areaS3": {
              "fill": "@svg2 !important"
            },
            ".carousel-control": {
              "background": "#000",
              "opacity": "0.2"
            },
            ".carousel": {
              "width": "80%",
              "margin": "auto"
            },
            ".mbr-section-subtitle": {
              "color": "#131419",
              "font-style": "normal",
              "font-size": "2.5rem",
              "font-weight": "900",
              "@media (max-width: 576px)": {
                "font-size": "1.5rem",
                "line-height": "2rem"
              }
            },
            ".mbr-section-title": {
              "@media (max-width: 576px)": {
                ".title-img": {
                  "width": "90px",
                  "height": "30px",
                  "margin-bottom": "5px",
                  "display": "inline-block",
                  "object-fit": "contain"
                }
              }
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              ".media-container-row": {
                "-webkit-flex-grow": "1",
                "flex-grow": "1"
              },
              ".wrap-img": {
                "text-align": "center",
                "img": {
                  "transition": "all 0.3s",
                  "max-height": "150px",
                  "width": "auto",
                  "max-width": "100%"
                }
              }
            },
            ".carousel-controls": {
              "display": "flex",
              "-webkit-justify-content": "center",
              "justify-content": "center",
              ".carousel-control": {
                "background": "#000",
                "border-radius": "50%",
                "position": "static",
                "width": "40px",
                "height": "40px",
                "margin-top": "2rem",
                "border-width": "1px",
                "&.carousel-control-prev": {
                  "left": "auto",
                  "margin-right": "20px",
                  "margin-left": "0"
                },
                "&.carousel-control-next": {
                  "right": "auto",
                  "margin-right": "0"
                },
                ".mbr-iconfont": {
                  "font-size": "1rem"
                }
              }
            },
            ".cloneditem-1, .cloneditem-2, .cloneditem-3, .cloneditem-4, .cloneditem-5": {
              "display": "none"
            },
            ".col-lg-15": {
              "-webkit-box-flex": "0",
              "-ms-flex": "0 0 100%",
              "-webkit-flex": "0 0 100%",
              "flex": "0 0 100%",
              "max-width": "100%",
              "position": "relative",
              "min-height": "1px",
              "padding-right": "10px",
              "padding-left": "10px",
              "width": "100%"
            },
            "@media (min-width: 992px)": {
              ".col-lg-15": {
                "-ms-flex": "0 0 20%",
                "-webkit-flex": "0 0 20%",
                "flex": "0 0 20%",
                "max-width": "20%",
                "width": "20%"
              },
              ".carousel-inner": {
                "opacity": "0.8",
                "&.slides2": {
                  "> .carousel-item.active.carousel-item-right, > .carousel-item.carousel-item-next": {
                    "left": "0",
                    "-webkit-transform": "translate3d(50%, 0, 0)",
                    "transform": "translate3d(50%, 0, 0)"
                  },
                  "> .carousel-item.active.carousel-item-left, > .carousel-item.carousel-item-prev": {
                    "left": "0",
                    "-webkit-transform": "translate3d(-50%, 0, 0)",
                    "transform": "translate3d(-50%, 0, 0)"
                  },
                  "> .carousel-item.carousel-item-left, > .carousel-item.carousel-item-prev.carousel-item-right, > .carousel-item.active": {
                    "left": "0",
                    "-webkit-transform": "translate3d(0, 0, 0)",
                    "transform": "translate3d(0, 0, 0)"
                  },
                  ".cloneditem-1, .cloneditem-2, .cloneditem-3": {
                    "display": "block"
                  }
                },
                "&.slides3": {
                  "> .carousel-item.active.carousel-item-right, > .carousel-item.carousel-item-next": {
                    "left": "0",
                    "-webkit-transform": "translate3d(33.333333%, 0, 0)",
                    "transform": "translate3d(33.333333%, 0, 0)"
                  },
                  "> .carousel-item.active.carousel-item-left, > .carousel-item.carousel-item-prev": {
                    "left": "0",
                    "-webkit-transform": "translate3d(-33.333333%, 0, 0)",
                    "transform": "translate3d(-33.333333%, 0, 0)"
                  },
                  "> .carousel-item.carousel-item-left, > .carousel-item.carousel-item-prev.carousel-item-right, > .carousel-item.active": {
                    "left": "0",
                    "-webkit-transform": "translate3d(0, 0, 0)",
                    "transform": "translate3d(0, 0, 0)"
                  },
                  ".cloneditem-1, .cloneditem-2, .cloneditem-3": {
                    "display": "block"
                  }
                },
                "&.slides4": {
                  "> .carousel-item.active.carousel-item-right, > .carousel-item.carousel-item-next": {
                    "left": "0",
                    "-webkit-transform": "translate3d(25%, 0, 0)",
                    "transform": "translate3d(25%, 0, 0)"
                  },
                  "> .carousel-item.active.carousel-item-left, > .carousel-item.carousel-item-prev": {
                    "left": "0",
                    "-webkit-transform": "translate3d(-25%, 0, 0)",
                    "transform": "translate3d(-25%, 0, 0)"
                  },
                  "> .carousel-item.carousel-item-left, > .carousel-item.carousel-item-prev.carousel-item-right, > .carousel-item.active": {
                    "left": "0",
                    "-webkit-transform": "translate3d(0, 0, 0)",
                    "transform": "translate3d(0, 0, 0)"
                  },
                  ".cloneditem-1, .cloneditem-2, .cloneditem-3": {
                    "display": "block"
                  }
                },
                "&.slides5": {
                  "> .carousel-item.active.carousel-item-right, > .carousel-item.carousel-item-next": {
                    "left": "0",
                    "-webkit-transform": "translate3d(20%, 0, 0)",
                    "transform": "translate3d(20%, 0, 0)"
                  },
                  "> .carousel-item.active.carousel-item-left, > .carousel-item.carousel-item-prev": {
                    "left": "0",
                    "-webkit-transform": "translate3d(-20%, 0, 0)",
                    "transform": "translate3d(-20%, 0, 0)"
                  },
                  "> .carousel-item.carousel-item-left, > .carousel-item.carousel-item-prev.carousel-item-right, > .carousel-item.active": {
                    "left": "0",
                    "-webkit-transform": "translate3d(0, 0, 0)",
                    "transform": "translate3d(0, 0, 0)"
                  },
                  ".cloneditem-1, .cloneditem-2, .cloneditem-3, .cloneditem-4": {
                    "display": "block"
                  }
                },
                "&.slides6": {
                  "> .carousel-item.active.carousel-item-right, > .carousel-item.carousel-item-next": {
                    "left": "0",
                    "-webkit-transform": "translate3d(16.666667%, 0, 0)",
                    "transform": "translate3d(16.666667%, 0, 0)"
                  },
                  "> .carousel-item.active.carousel-item-left, > .carousel-item.carousel-item-prev": {
                    "left": "0",
                    "-webkit-transform": "translate3d(-16.666667%, 0, 0)",
                    "transform": "translate3d(-16.666667%, 0, 0)"
                  },
                  "> .carousel-item.carousel-item-left, > .carousel-item.carousel-item-prev.carousel-item-right, > .carousel-item.active": {
                    "left": "0",
                    "-webkit-transform": "translate3d(0, 0, 0)",
                    "transform": "translate3d(0, 0, 0)"
                  },
                  ".cloneditem-1, .cloneditem-2, .cloneditem-3, .cloneditem-4, .cloneditem-5": {
                    "display": "block"
                  }
                }
              }
            },
            "H2": {
              "color": "#121212"
            },
            ".carousel-control-prev": {
              "position": "absolute!important",
              "left": "-50px !important"
            },
            ".carousel-control-next": {
              "position": "absolute!important",
              "right": "-50px !important"
            },
            "@media (max-width: 576px)": {
              ".carousel-control-prev": {
                "left": "-10px !important"
              },
              ".carousel-control-next": {
                "right": "-10px !important"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "clients01",
          "_sourceTheme": "techm4",
          "_customHTML": "<section class=\"clients\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-clients-slider\">\n    <mbr-parameters>\n        \n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"11\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"30\" step=\"1\" value=\"8\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <input type=\"color\" title=\"Figure Color 1\" name=\"svg1\" value=\"#fff0b0\" selected>\n        <input type=\"color\" title=\"Figure Color 2\" name=\"svg2\" value=\"#ffdf58\" selected>\n        <input type=\"range\" inline title=\"Items\" name=\"slidesCount\" min=\"1\" max=\"20\" step=\"1\" value=\"13\">\n        <select title=\"Visible Slides\" name=\"visibleSlides\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background2-2.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Gradient Background\" name=\"gradientBg\" condition=\"bg.type=='color'\">\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#ffffff\" condition=\"gradientBg &&bg.type=='color'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n\n    <svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1380px\" height=\"810px\" viewBox=\"0 -8.992806499463768e-14 1380 810\" preserveAspectRatio=\"xMidYMid meet\">\n        <rect id=\"svgEditorBackground\" x=\"0\" y=\"0\" width=\"1380\" height=\"810\" style=\"fill: none; stroke: none;\"></rect>\n        <defs id=\"svgEditorDefs\">\n            <polygon id=\"svgEditorShapeDefs\" style=\"fill:khaki;stroke:black;vector-effect:non-scaling-stroke;stroke-width:1px;\"></polygon>\n            <path id=\"svgEditorClosePathDefs\" style=\"stroke:black;stroke-width:1px;fill:khaki;\"></path>\n        </defs>\n        <path d=\"M15083.791600683318,645.6720847341486c496.6000000000058,747.7999999999951,1953.3704016668416,1862.6734725832403,2751.999999999978,1967.9999999999955s1884.300000000003,-198.89999999999964,2718.7056474818382,-552.6365690040448s1746.4898225846773,-519.9524548776521,2593.2943525181545,-567.3634309959566s2251,-23.399999999999636,4384,1520.0000000000032s3205.199999999997,1437.2000000000025,4047.9999999999854,1520.0000000000018s3305.000000000029,-270.2999999999993,4640.000000000029,-1152s74.60000000000582,3328.3000000000065,32,3792.0000000000073s-19509.4,4591.000000000004,-21087.999999999993,-128.00000000000182s-1679.5999999999913,-6358.300000000001,-80,-6400Z\" style=\"stroke:black;fill:khaki;stroke-width:0px;\" id=\"e12_areaS3\" transform=\"matrix(0.0650006 -0.00123765 0.00123765 0.0650006 -995.543 317.589)\"></path>\n        <path d=\"M12434.469938292996,-979.2324603008726c496.600000000004,747.8000000000001,1953.3704016668398,1862.673472583247,2752.000000000018,1967.9999999999995s1884.2999999999865,-198.90000000000055,2718.7056474818364,-552.6365690040473s1746.4898225846846,-519.9524548776479,2593.2943525181618,-567.3634309959524s2251,-23.400000000001455,4384,1520s3205.199999999997,1437.1999999999962,4048,1519.9999999999955s3304.9999999999927,-270.3000000000011,4640,-1151.9999999999955s74.60000000000582,3328.3,32,3791.9999999999955s-19509.400000000023,4590.999999999997,-21088.000000000015,-127.99999999999818s-1679.5999999999985,-6358.300000000008,-80,-6400.0000000000055Z\" style=\"stroke:black;fill:aqua;stroke-width:0px;\" id=\"e19_areaS3\" transform=\"matrix(0.0647268 0.00608646 -0.00608646 0.0647268 -823.261 331.266)\"></path><text dy=\"-0.5em\" style=\"fill:black;font-family:Arial;font-size:20px;\" id=\"e14_texte\" transform=\"matrix(0.0640454 0 0 0.0640454 -832.187 329.878)\">\n            <textPath id=\"e13_textPath\" xlink:href=\"#e12_areaS3\">T</textPath>\n        </text>\n    </svg>\n    <div class=\"container mb-5\" mbr-if=\"showTitle||showSubtitle\">\n        <div class=\"media-container-row\">\n            <div class=\"col-12 align-center\">\n                <h2 class=\"mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b><img src=\"@PROJECT_PATH@/assets/images/logo-black.png\" alt=\"Kool Logo\" class=\"title-img\">&nbsp;Brands</b></h2>\n                <h3 class=\"mbr-section-subtitle\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\"><b>Marcas Kool</b></h3>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"container\">\n        <div class=\"carousel slide\" data-ride=\"carousel\" role=\"listbox\">\n            <div class=\"carousel-inner\" mbr-list mbr-list-grow=\"slidesCount\" data-visible=\"{{visibleSlides}}\">\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/rappi-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/uala-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/tec-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/starbucks-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/sigma-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/walmart-2000x1500.jpg\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/mattel-2-600x300.jpeg\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/new-balance-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/herdez-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/rayados-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/diamond-films-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/shein-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/oggi-photoroom.png-photoroom.webp\" class=\"img-responsive clients-img\" alt>\n                            </div>\n                        </div>\n                    </div>\n                </div></div>\n            <div class=\"carousel-controls\">\n                <a data-app-prevent-settings class=\"carousel-control carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                    <span aria-hidden=\"true\" class=\"mbri-left mbr-iconfont\"></span>\n                    <span class=\"sr-only\">Previous</span>\n                </a>\n                <a data-app-prevent-settings class=\"carousel-control carousel-control-next\" role=\"button\" data-slide=\"next\">\n                    <span aria-hidden=\"true\" class=\"mbri-right mbr-iconfont\"></span>\n                    <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "marcas-kool",
          "_isUserblock": true,
          "_cid": "u5GU4xu0To",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
