            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header4\" group=\"Headers\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButton\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h5 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><b>Privacy Policy for Cookies</b></h5>\n        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .button-align\"><br><b>What are cookies?</b><br>Cookies are small text files that are stored on your device when you visit our website. We use cookies to improve your browsing experience, understand how our site is used and for analytical purposes.<br><br><b>Types of cookies we use</b><br>- <u>Strictly necessary cookies:</u> These cookies are essential for the website to function correctly and allow you to navigate through it.<br>- <u>Analytical cookies:</u> These cookies help us understand how users interact with our website, collecting and reporting information anonymously.<br>- <u>Functionality cookies:</u> These cookies allow the website to remember your preferences and options, providing a more personalized experience.<br>- <u>Advertising and marketing cookies</u><u>:</u> These cookies are used to deliver relevant advertisements and limit the number of times an advertisement is shown.<br><br><b>How to manage cookies</b><br>You can adjust your browser settings to accept or reject all cookies, or receive a notification when a cookie is delivered to you. However, if you reject all cookies, you may not be able to use all the features of our website.<br><br><b>Changes to the Cookies Policy</b><br>Kool Studio reserves the right to modify this Cookies Policy at any time. Any changes will be posted on our website.<br><br>If you have any questions or concerns about our Cookies Policy, do not hesitate to contact us through our social networks.<br><br><i>Last update date: April 2024.</i></p>\n        <div class=\"button-align\" mbr-if=\"showButton\">\n            <div class=\"mbr-section-btn margin\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-primary\" href data-app-placeholder=\"Type Text\">Become Sponsor</a></div>\n        </div>\n    </div>\n</section>",
          "_anchor": "header4-73",
          "_isUserblock": true,
          "_cid": "u8gODjmYCv",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".social-row": {
              "display": "flex",
              "flex-wrap": "wrap",
              "@media (max-width: 767px)": {
                "justify-content": "center",
                ".soc-item": {
                  "margin-right": "0",
                  "margin": "0 0.5rem"
                }
              }
            },
            ".mbr-section-subtitle": {
              "letter-spacing": "0"
            },
            "a": {
              "width": "100%",
              "height": "100%",
              "display": "flex",
              "justify-content": "left",
              "align-items": "left",
              "@media (max-width: 767px)": {
                "justify-content": "center"
              }
            },
            "li": {
              "line-height": "2"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "height": "3.2rem",
              "width": "3.2rem",
              "&:hover": {
                ".mbr-iconfont": {
                  "color": "@primaryColor"
                }
              }
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem",
                "justify-content": "center"
              },
              "color": "#bbbbbb"
            },
            ".list2": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "3rem",
                "justify-content": "center"
              },
              "color": "#bbbbbb"
            },
            ".mbr-text": {
              "color": "#bbbbbb"
            },
            ".mbr-text-special": {
              "color": "#bbbbbb",
              "&:hover": {
                "color": "@primaryColor"
              }
            },
            ".mbr-iconfont": {
              "transition": "color 0.3s",
              "color": "@icons",
              "font-size": "1.2rem"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "designerm4",
          "_customHTML": "<section class=\"footer1\" group=\"Footes\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" global once=\"footers\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <header>Color</header>\n        <input type=\"color\" title=\"Icons\" name=\"icons\" value=\"#bbbbbb\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background8.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#131419\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mbr-white align-left\">\n            <div class=\"col-12 col-md-6 col-lg-3\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                    <b>Kool Studio</b></h5>\n\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-3\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                    <b>Location</b></h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article>\n\n                    <li class=\"mbr-text item-wrap\">Avanta Gardens, San Pedro Garza García, México</li><li class=\"mbr-text item-wrap\"><br></li><li class=\"mbr-text item-wrap\"><br></li>\n                    <li class=\"mbr-text item-wrap\"><br></li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-3\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                    <b>Links</b></h5>\n                <ul class=\"list2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article>\n                     <li class=\"item-wrap\"><a class=\"mbr-text-special\" href=\"index.html\">Home</a></li>\n                     <li class=\"item-wrap\"><a class=\"mbr-text-special\" href=\"about-us.html\">About Us</a></li>\n                     <li class=\"item-wrap\"><a class=\"mbr-text-special\" href=\"success-stories.html\">Success Stories</a></li>\n                     <li class=\"item-wrap\"><a class=\"mbr-text-special\" href=\"tiktok-marketing-partners.html\">TikTok Partners</a></li>\n                     <li class=\"item-wrap\"><a class=\"mbr-text-special\" href=\"our-services.html\">Services</a></li>\n                     <li class=\"item-wrap\"><a class=\"mbr-text-special\" href=\"contact-us.html\">Be Kool</a></li>\n                </ul>\n            </div>\n            \n   <div class=\"col-12 col-md-6 col-lg-3\">\n        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>Follow Kool</b></h5>\n\n        <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n            <div class=\"soc-item\">\n                <a href=\"https://www.tiktok.com/@koolstudio___\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-tiktok socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                <a href=\"https://www.linkedin.com/company/kool-studio-mx/\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                <a href=\"https://www.instagram.com/koolstudio___/\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-skype socicon\"></span>\n                </a>\n            </div>\n        </div>\n       <br>\n        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>Follow Kari</b></h5>\n\n        <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n            <div class=\"soc-item\">\n                <a href=\"https://www.tiktok.com/@kari.tips\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-tiktok socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                <a href=\"https://www.linkedin.com/in/karinarosas/\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                <a href=\"https://www.instagram.com/kari.tipsdemkt/\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-skype socicon\"></span>\n                </a>\n            </div>\n        </div>\n        <br>\n        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>Follow Pepe</b></h5>\n\n        <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n            <div class=\"soc-item\">\n                <a href=\"https://www.tiktok.com/@pepegg33\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-tiktok socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                <a href=\"https://www.linkedin.com/in/pepegg33/\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                <a href=\"https://www.instagram.com/pepegg33/\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                </a>\n            </div>\n            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                    <span mbr-icon class=\"mbr-iconfont socicon-skype socicon\"></span>\n                </a>\n            </div>\n        </div>\n    </div>\n            \n\n            \n           \n        </div>\n    </div>\n</section>",
