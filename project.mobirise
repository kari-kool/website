              "color": "#121212"
            },
            ".title-img": {
              "width": "160px",
              "height": "40px",
              "margin-bottom": "10px",
              "display": "inline-block",
              "object-fit": "contain",
              "@media (max-width: 576px)": {
                "width": "90px",
                "height": "30px",
                "margin-bottom": "5px",
