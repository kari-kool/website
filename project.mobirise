          "_name": "features01",
          "_sourceTheme": "designerm4",
          "_customHTML": "<section class=\"features1\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffdf58\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#131419\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 pb-5\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">OUR SERVICES</h5>\n\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>Features</b>\n                </h3>\n\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\">\n                <div class=\"card-wrapper\">\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-contact-form mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Kool Creators</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">We get the koolest influencers\n\n<br>just for you.\n\n<br><br>We are there from the first draft\n\n<br>of any campaign strategy to\n\n<br>negotiation and implementation.</p>\n                        <a href=\"nuestros-servicios.html#afeatures7-42\">\n                        </a><div class=\"link-wrap\"><a href=\"nuestros-servicios.html#afeatures7-42\">\n                            </a><h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\"><a href=\"nuestros-servicios.html#afeatures7-42\"></a><a href=\"our-services.html#kool-creators\" class=\"text-primary\">Find out more</a></h6>\n                    </div>\n                </div>\n            </div>\n            \n            \n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\">\n                <div class=\"card-wrapper\">\n\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-responsive-2 mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Kool Ads <br>Management</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Ad strategies customized to\n\n<br>your goals. <br><br>Google, TikTok, Meta,\n\n<br>Twitch and Spotify.</p>\n                        <a href=\"nuestros-servicios.html#afeatures7-41\">\n                        </a><div class=\"link-wrap\"><a href=\"nuestros-servicios.html#afeatures7-41\">\n                            </a><h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\"><a href=\"nuestros-servicios.html#afeatures7-41\"></a><a href=\"our-services.html#kool-ads-management\" class=\"text-primary\">Find out more</a></h6>\n                        </div>\n                        \n                </div>\n            </div>\n            \n            \n            \n            \n            \n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v2-ticket mobi-mbri-credit-card mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Kool Events</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">We create kool short form\n\n<br>content for your brand at\n\n<br>festivals, company events, etc.\n\n<br><br>And yeah, the koolest\n\n<br>aftermovies.&nbsp;</p>\n                        <a href=\"nuestros-servicios.html#afeatures7-40\">\n                        </a><div class=\"link-wrap\"><a href=\"nuestros-servicios.html#afeatures7-40\">\n                            </a><h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\"><a href=\"nuestros-servicios.html#afeatures7-40\"></a><a href=\"our-services.html#social-media-is-kool\" class=\"text-primary\">Find out more</a></h6>\n                        </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Relations</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Curabitur id nulla vitae finibus ultricies. Sed gravida metus\n                            vestibulum tortor.</p>\n\n                        <div class=\"link-wrap\">\n                            <h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\">Read\n                                More</h6>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u3JOIVCWW0",
          "_anchor": "servicios-2",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
