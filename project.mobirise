        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "@media (max-width: 767px)": {
              ".display-2": {
                "font-size": "1.6rem"
              }
            },
            ".align-wrapper": {
              "width": "100%"
            },
            "h4": {
              "display": "inline-block",
              "position": "relative",
              "width": "fit-content",
              "transition": "all 0.3s",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "bottom": "-6px",
                "width": "0%",
                "left": "0",
                "height": "2px",
                "transition": "all 0.3s",
                "background": "@primaryColor"
              },
              "&:hover": {
                "color": "@primaryColor",
                "&:before": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#bbbbbb",
              "text-align": "center"
            },
            ".mbr-section-text, .align-wrapper, .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "contacts02",
          "_sourceTheme": "designerm4",
          "_customHTML": "<section class=\"contacts2\" group=\"Contacts\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Mail\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#131419\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n\n                <div class=\"align-wrapper align-left\">\n                    <h4 class=\"mbr-section-text align-left mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-text, .align-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-2\"><b>\n                            Services</b></h4>\n                </div>\n                                <h3 class=\"mbr-section-title mbr-fonts-style align-left pb-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\">From the idea to the format you prefer.&nbsp;<b>We make Kool things happen.&nbsp;</b></h3>\n                <div class=\"mbr-section-btn align-left\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-lg btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">CONTACT US</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u3JRrPcc8K",
          "_anchor": "servicios",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-iconfont": {
              "display": "inline-flex",
              "font-size": "2.5rem",
              "align-items": "center",
              "color": "@iconColor",
              "border-radius": "50%",
              "width": "90px",
              "height": "90px"
            },
            ".card-link, .link-wrap, .card-link:before": {
              "color": "#bbbbbb"
            },
            ".card-wrapper": {
              "overflow": "visible",
              "box-shadow": "0 6px 24px -2px rgba(119, 139, 165, 0.2)",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0rem",
              "padding-bottom": "1rem",
              "border-radius": "10%"
            },
            ".card-link": {
              "position": "relative",
              "padding": "0",
              "margin": "0",
              "margin-right": "1.5rem",
              "transition": "all 0.3s",
              "width": "fit-content",
              "cursor": "pointer",
              "display": "inline-block",
              "&:before": {
                "font-family": "'Moririse2'",
                "content": "\"\\e96b\"",
                "position": "absolute",
                "font-size": "1rem",
                "top": "50%",
                "transition": "all 0.3s",
                "transform": "translateY(-50%)",
                "right": "-1.5rem"
              },
              "&:hover": {
                "color": "@primaryColor",
                "transition": "all 0.3s",
                "&:before": {
                  "right": "-2rem",
                  "color": "@primaryColor",
                  "transition": "all 0.3s"
                }
              }
            },
            ".card-text": {
              "color": "#fafafa"
            },
            ".card-title, .icon-wrap": {
              "color": "#ffdf58"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "features01",
          "_sourceTheme": "designerm4",
          "_customHTML": "<section class=\"features1\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffdf58\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#131419\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 pb-5\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">OUR SERVICES</h5>\n\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>Features</b>\n                </h3>\n\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\">\n                <div class=\"card-wrapper\">\n\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-change-style mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Kool Creativity</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">We develop super kool creative concepts for your campaign.<br><br> Sometimes we do say: <i>\"How the hell did we come up with that? It’s so kool.”</i></p>\n\n                        <a href=\"nuestros-servicios.html#afeatures7-43\">\n                        </a><div class=\"link-wrap\"><a href=\"nuestros-servicios.html#afeatures7-43\">\n                            </a><h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\"><a href=\"nuestros-servicios.html#afeatures7-43\"></a><a href=\"our-services.html#kool-creativity\" class=\"text-primary\">Find out more</a></h6>\n                        </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mbrib-camera\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Kool Productions</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">We also make our ideas a reality.\n\n<br><br>We give you the art of\n\n<br>filmmaking, yes, even on TikTok.<br></p>\n                        \n                         <a href=\"nuestros-servicios.html#afeatures7-3z\">\n                        </a><div class=\"link-wrap\"><a href=\"nuestros-servicios.html#afeatures7-3z\">\n                            </a><h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\"><a href=\"nuestros-servicios.html#afeatures7-3z\"></a><a href=\"our-services.html#kool-productions\" class=\"text-primary\">Find out more</a></h6>\n                        </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n<div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Kool UGC <br>Ad Creatives</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Real content, real impact.\n\n<br><br>We are pioneers in UGC\n\n<br>strategies for your brand in\n\n<br>social media.&nbsp;<br></p>\n                        <a href=\"nuestros-servicios.html#afeatures7-45\">\n                        </a><div class=\"link-wrap\"><a href=\"nuestros-servicios.html#afeatures7-45\">\n                            </a><h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\"><a href=\"nuestros-servicios.html#afeatures7-45\"></a><a href=\"our-services.html#kool-ugc-ad-creatives\" class=\"text-primary\">Find out more</a></h6>\n                        </div>\n\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-3 md-pb\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n<div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\" mbr-if=\"showIcon\"></span>\n                        </div>\n                        <h5 class=\"card-title mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .icon-wrap\">Relations</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Curabitur id nulla vitae finibus ultricies. Sed gravida metus\n                            vestibulum tortor.</p>\n\n                        <div class=\"link-wrap\">\n                            <h6 class=\"card-link align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link, .link-wrap, .card-link:before\">Read\n                                More</h6>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
