        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "position": "relative",
            ".decor-wrap": {
              "position": "absolute",
              "top": "-30%",
              "right": "5%",
              "border": "60px solid @decor",
              "border-left": "60px solid transparent",
              "border-bottom": "60px solid transparent",
              "width": "50%",
              "height": "160%",
              "border-radius": "100%",
              "transform": "rotate(15deg)",
              "& when (@reverseContent)": {
                "right": "auto",
                "left": "-10%"
              }
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 50px",
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".row": {
              "position": "relative",
              "z-index": "1"
            },
            ".title-wrapper": {
              "margin-bottom": "20px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".subtitle-wrapper": {
                ".mbr-section-subtitle": {
                  "display": "inline-flex",
                  "margin-bottom": "56px",
                  "padding": "18px 24px",
                  "border-radius": "16px !important",
                  "box-shadow": "6px 8px 0 0 @shadow",
                  "background-color": "@subtitleBg",
                  "transform": "rotate(-4deg)",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "32px"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".text-wrapper": {
              "padding-left": "140px",
              "@media (max-width: 1440px)": {
                "padding-left": "64px"
              },
              "@media (max-width: 992px)": {
                "padding-left": "0",
                "margin-bottom": "32px"
              },
              "& when (@reverseContent)": {
                "padding-left": "0",
                "padding-right": "140px",
                "@media (max-width: 1440px)": {
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-right": "0"
                }
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".box": {
              "border-radius": "16px !important",
              "margin-left": "32px",
              "margin-top": "-12rem",
              "@media (max-width: 992px)": {
                "margin-left": "0",
                "margin-top": "0"
              },
              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "32px",
                "@media (max-width: 992px)": {
                  "margin-right": "0"
                }
              },
              ".mbr-media": {
                "position": "relative",
                "overflow": "hidden",
                "height": "350px",
                ".mbr-iconfont": {
                  "font-size": "25px",
                  "transition": "all 0.3s ease-in-out",
                  "margin-left": "5px",
                  "z-index": "1"
                }
              }
            },
            ".mbr-media": {
              "position": "relative",
              "img": {
                "object-fit": "cover",
                "border-radius": "0 !important"
              }
            },
            "a": {
              "&:hover": {
                "background-image": "none !important"
              }
            },
            ".icon-wrap": {
              "left": "50%",
              "top": "50%",
              "transform": "translate(-50%, -50%)",
              "position": "absolute",
              "height": "60px",
              "width": "60px",
              "border-radius": "100%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "transition": "all 0.3s ease-in-out",
              "z-index": "1",
              "cursor": "pointer",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "width": "100%",
                "height": "100%",
                "border-radius": "100%",
                "opacity": ".2",
                "transition": "all 0.3s ease-in-out",
                "pointer-events": "none"
              },
              "&:hover, &:focus": {
                "&::before": {
                  "opacity": ".5"
                }
              }
            },
            ".mbr-media span": {
              "font-size": "5rem",
              "transition": "all 0.2s"
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "calc(80vw / 1.778)",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            ".close": {
              "position": "fixed",
              "opacity": "0.5",
              "font-size": "1.5rem",
              "font-weight": "300",
              "width": "60px",
              "height": "60px",
              "border-radius": "50%",
              "color": "#fff",
              "top": "2.5rem",
              "right": "2.5rem",
              "border": "2px solid #fff",
              "text-shadow": "none",
              "z-index": "5",
              "transition": "opacity 0.3s ease",
              "align-items": "center",
              "justify-content": "center",
              "display": "flex",
              "&:hover": {
                "opacity": "1",
                "background": "#000",
                "color": "#fff"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            }
          },
          "_name": "video01",
          "_sourceTheme": "replym5",
          "_customHTML": "<section class=\"video01 replym5\" group=\"Image & Video\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"color\" title=\"Subtitle BG\" value=\"#ee1d52\" name=\"subtitleBg\" condition=\"showSubtitle\" selected>\n        <input type=\"color\" title=\"Shadow Color\" value=\"#000000\" name=\"shadow\" condition=\"showSubtitle\" selected>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Decoration\" name=\"showDecor\" checked>\n        <input type=\"color\" title=\"Decoration Color\" value=\"#69c9d0\" name=\"decor\" condition=\"showDecor\" selected>\n        <header>Image</header>\n        <input type=\"image\" title=\"Image Source\" name=\"imageSource\" value=\"@ADDONS_PATH@/replym5/components/_images/image.jpg\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/replym5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/replym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"title-wrapper\">\n                    <div class=\"subtitle-wrapper\">\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            #PARTNERS</h3>\n                    </div>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">We are where GEN Z always is:&nbsp;</p>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>TikTok</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"subtitle-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        <span class=\"mdi-content-add-circle mbr-iconfont\"></span>&nbsp;We are one of the few agencies in LATAM certified in <b>TikTok Marketing</b>. Both creative and performance.<br><br>\n                        <span class=\"mdi-content-add-circle mbr-iconfont\"></span>&nbsp;We are also certified as <b>TikTok Creative Partners</b>. You can work with us through the <b>TikTok Creative Exchange program.</b>\n                    </p>\n                   <!--<div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>¿Want to know more?&nbsp;</a></div>-->\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\" style=\"display: flex; align-items: center; justify-content: center; position: relative;\">\n                <div class=\"box\" style=\"transform: rotate(5deg); margin-left: 0px; width: 70%; height: auto;\">\n                    <img src=\"@PROJECT_PATH@/assets/images/tiktok-logo-2-1.svg\" alt=\"Image\" style=\"width:100%; height:auto;\">\n                    <img src=\"@PROJECT_PATH@/assets/images/isotipo-koolstudio-circle-148x148.png\" alt=\"Overlay Image\" style=\"position: absolute; top: -20%; right: -20%; width: 50%; height: auto;\">\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"decor-wrap\" mbr-if=\"showDecor\"></div>\n</section>",
          "_cid": "uDYkyixWh6",
