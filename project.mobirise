            },
            ".mbr-section-title": {
              "color": "#131419",
              "text-align": "left"
            },
            ".mbr-desc": {
              "color": "#08323C"
            },
            ".mbr-text": {
              "color": "#131419"
            },
            ".mbr-desc, .mbr-section-btn": {
              "color": "#131419"
            }
          },
          "_customHTML": "<section class=\"video1 elevatem5\" group=\"Image & Video\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Play Color\" value=\"#ffffff\" name=\"play\" selected>\n        <input type=\"color\" title=\"Play BG\" value=\"#e6c63b\" name=\"playBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <div class=\"mbr-section-title\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Ualá&nbsp;&nbsp;</b></h2>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\"><b>Ualá constantly pushes us towards innovation, and there was one project where we truly exceeded expectations. Within a week, we produced an advertising spot that was ready for the big screen and social media distribution. This spot has become one of the brand’s most successful in their media history.</b><br></p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">As the banking ecosystem evolves, Ualá needed to communicate its new features. <br><br>To meet this challenge, we crafted spots aimed at engaging their audience through effective storytelling. <br><br>Moreover, for the past three years, we've been honing our content strategies on TikTok to heighten awareness of Ualá's products and their advantages.<br></p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            See More\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"video-block\">\n                    <div mbr-video class=\"video-wrapper\">\n                        <iframe src=\"https://youtu.be/ihtVskyJ9-E?loop=1&autoplay=1\"></iframe>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "caso-de-exito-uala",
          "_isUserblock": true,
          "_cid": "u3K8AHPMKX",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider03",
          "_sourceTheme": "energym5",
          "_styles": {
            ".image-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".image-wrap": {
                "position": "relative",
                "border": "2px solid #000000",
                "border-radius": "3rem !important",
                "width": "332px",
                "height": "690px",
                "display": "flex",
                "justify-content": "center",
                "background-color": "#000000",
                "box-shadow": "25px 32px 60px #000000",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "16px",
                  "width": "98px",
                  "height": "28px",
                  "border-radius": "1rem",
                  "background-color": "#000000",
                  "@media (max-width: 1200px)": {
                    "top": "13px",
                    "width": "68px",
                    "height": "22px",
                    "box-shadow": "12px 12px 12px !important"
                  }
                },
                "@media (max-width: 1200px)": {
                  "width": "232px",
                  "height": "460px",
                  "box-shadow": "12px 12px 12px!important"
                },
                "video": {
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "border": "7px solid #000000",
                  "background-color": "#000000",
                  "border-radius": "3rem !important"
                }
              }
            },
            ".text-section": {
              "padding": "80px",
              ".mbr-section-title": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px"
                }
              },
              ".mbr-desc": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px"
                }
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px"
                }
              }
            },
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 70px",
                "@media (max-width: 1440px)": {
                  "padding": "0 48px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "90%",
              "max-width": "90%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "box-shadow": "0px 0px 5px 2px rgba(0, 0, 0, 0.1)",
                "padding": "20px",
                "border-radius": "1.2rem !important",
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "position": "relative",
                    "border-radius": "1.2rem",
                    "display": "flex",
                    "align-items": "flex-end",
                    "min-height": "720px",
                    "padding": "30px",
                    "@media (max-width: 992px)": {
                      "padding": "24px",
                      "min-height": "400px"
                    },
                    "img": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "object-fit": "cover",
                      "border-radius": "1.2rem !important"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "transform": "translateY(-50%)",
              "width": "50px",
              "height": "50px",
              "font-size": "22px",
              "background-color": "#fff !important",
              "border-radius": "50%",
              "box-shadow": "0px 0px 10px rgba(0, 0, 0, 0.5)",
              "color": "@secondaryColor !important",
              "border": "none",
              "transition": "all 0.3s ease-in-out",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "@media (max-width: 640px)": {
                "top": "20%"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "opacity": ".5 !important"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem",
              "@media (max-width: 767px)": {
                "overflow": "hidden "
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-text": {
              "text-align": "left"
            },
            "@media (max-width: 992px)": {
              ".slide-content": {
                "flex-direction": "column"
              },
              ".image-wrapper": {
                "width": "100%",
                "margin-bottom": "20px"
              },
              ".text-section": {
                "width": "100%",
                "padding": "20px 0"
              }
            }
          },
          "_customHTML": "<section class=\"slider03 mbr-embla energym5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n     <!--   <input type=\"color\" name=\"border\" title=\"Border Color\" value=\"#dfe6ea\" condition=\"arrows\">-->\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#ffdf58\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_yoplait.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Yoplait&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">\n                        Yoplait has been in the hands of the Kool team for a while now. \n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Through its 'Griego de Verdad' product line, we've whipped up some fantastic recipes. With 'Grie-Go,' we worked with kids to create some really Kool content. These initiatives have allowed us to adapt and produce exactly the kind of content Yoplait was aiming for, achieving those 'how did they do that?!' results. Plus, we stepped out of our comfort zone by diving into Pinterest, and guess what? It turned out super Kool.&nbsp;<br></p>\n                                    </div>                  \n                                </div>\n                            </div>\n                                                        <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_newBalance.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>New Balance&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">\n                        The koolest influencers for a kool brand\n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Just like Hailey Bieber shows on her IG, we know that New Balance is the trendiest brand in sports right now. <br><br>New Balance is one of the first brands to trust Kool in Mexico. We have developed their influencer strategy since 2022. <br><br>This year, we took influencer Emilio Antún to run the London Marathon, where we told his story from beginning... to a really interesting end.</p>\n                                    </div>                  \n                                </div>\n                            </div>   \n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_rappi.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Rappi&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">\n                        Rappi is one of the first brands we worked with.  \n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">The primary challenge in our collaboration with Rappi has been to forge a connection with users while highlighting the brand's values, initiatives, and benefits. Our dual role as both 'users' and 'representatives' of the brand significantly enhances our understanding of how to convey Rappi's message to consumers effectively.</p>\n                                    </div>                  \n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_fud.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Tec de Monterrey&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">\n                        KOOL is fuuuulll of EXATECs. \n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">That's why our return to our alma mater, to boost their TikTok, Instagram, and YouTube strategies, felt incredibly rewarding. In just one year, we managed to organically increase their follower count to over 400K. Plus, we initiated the 'TecTokers' program at a national scale, engaging student interns in creating daily TikToks following a vibrant KOOL strategy. Sounds like the koolest internship ever, right?</p>\n                                    </div>                  \n                                </div>\n                            </div>\n                                                        <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_hoyToca.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>HoyToca&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">\n                        HoyToca is code for: let’s make viral content.\n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">This is what we have done with HoyTocaRecetas on TikTok through their Always On strategy (drumroll please…): As Grupo Herdez's recipe platform, our \"HoyToca Mayonesa McCormick\" campaign earned us a nomination for a TikTok Ad Award. This strategy goes beyond just sharing recipes; it involves portraying the brand's lifestyle with content that's both relatable and creative. In just one year, we've garnered over 150K followers, achieved more than 121 million views, and received over 1 million likes.&nbsp;<br></p>\n                                    </div>                  \n                                </div>\n                            </div>   \n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_films.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Diamond Films&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">\n                        Our way of working with Diamond Films is different. \n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">We don't operate on an 'Always On' basis; instead, we conceive stand-alone projects that align with (and surpass) the excellence of their monthly film debuts. In collaboration with <i>cinetokers</i>, we create innovative and unique content for the Diamond Films account, delivering essential network advertising to the studio. Our strength lies in our creative liberty. Being part of the audience and <i>cinetokers</i> ourselves, we have a keen understanding of what captivates the audience.\n                    </p>\n                                    </div>                  \n                                </div>\n                            </div>\n<div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\" style=\"display:flex;\">\n                                    <div class=\"col-12 col-lg-4\" style=\"flex:1;\">\n <div class=\"image-wrapper\">\n                    <div class=\"image-wrap\">\n                         <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/work_chimex.mp4\"></video>\n                    </div>\n                </div>\n                                    </div>\n                                    <div class=\"col-12 col-lg-8 text-section\" style=\"flex:1;\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>CHIMEX&nbsp;</b></h2>\n                                     <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\">We created one of the most successful campaigns in Sigma Alimentos history.</p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">We had a clear mission for Chimex, a super brand dominating Mexico's kitchens. We aimed to connect with home chefs, often moms, demonstrating that with Chimex, making everything last becomes an art form. Achieving an average watch time of 9 to 10 seconds and over 38.6 million impacts, the flood of 'Me comí un comercial' comments was beyond imagination. And yes, we're showing off—this campaign emerged as Sigma Alimentos' most triumphant, making waves not just on TikTok but across digital media.&nbsp;<br></p>\n                                    </div>                  \n                                </div>\n                            </div>      \n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
