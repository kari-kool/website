            ".mbr-section-btn": {
              "margin-top": "34px",
              "@media (max-width: 991px)": {
                "margin-top": "14px"
              },
              "@media (max-width: 767px)": {
                "margin-top": "4px"
              }
            },
            ".title-img": {
              "width": "160px",
              "height": "40px",
              "margin-bottom": "10px",
              "display": "inline-block",
              "object-fit": "contain",
              "@media (max-width: 576px)": {
                "width": "90px",
                "height": "30px",
                "margin-bottom": "8px",
                "display": "inline-block",
                "object-fit": "contain"
              }
            }
          },
          "_customHTML": "<section class=\"features7 calmm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background3-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-small': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-items-center justify-content-center\">\n            <div class=\"item-img\">\n                <video autoplay loop muted playsinline src=\"https://www.koolstudio.mx/assets/videos/video_creatives.mp4\"></video>\n            </div>\n            <div class=\"item-content\" mbr-if=\"showTitle || showList || showText || showButtons\">\n                <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><img src=\"@PROJECT_PATH@/assets/images/logo-black.png\" alt=\"Kool Logo\" class=\"title-img\"><b> UGC Ad Creatives</b></h5>\n                <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">\n                    Boosting over 100 creators throughout LATAM, we specialize in crafting organic content that genuinely sells. <br><br><b>Our formula:</b>&nbsp;authenticity + creativity = real impact for your brand.\n                </p>\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"contact-us.html\" class=\"btn btn-warning\" data-app-placeholder=\"Type Text\">Discover more</a>\n    <a href=\"contact-us-ugc-creator.html\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">I want to be a UGC creator&nbsp;<br></a></div>\n\n            \n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "kool-ugc-ad-creatives",
          "_isUserblock": true,
          "_cid": "u4oupr5xwL",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
