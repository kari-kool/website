        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".team-card": {
              "margin-bottom": "2rem",
              "transition": "all 0.3s",
              "&:hover": {
                "transform": "translateY(-10px)"
              }
            },
            ".container": {
              "max-width": "1500px"
            },
            ".card2": {
              "margin-top": "3rem"
            },
            "img": {
              "transition": "all 0.3s",
              "object-fit": "cover",
              "width": "100%",
              "height": "100%"
            },
            "h5": {
              "margin-bottom": "0.2rem"
            },
            ".image-wrap": {
              "transition": "all 0.3s",
              "overflow": "hidden",
              "height": "500px",
              "border-radius": "5%"
            },
            ".mbr-role": {
              "transition": "all 0.3s"
            },
            ".card-wrap": {
              "padding": "2rem",
              "border-radius": "4px",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              "@media (max-width: 1400px)": {
                "padding": "0rem"
              },
              ".image-wrap img": {
                "width": "100%",
                "border-radius": "10%"
              },
              ".content-wrap": {
                "padding-top": "2rem",
                "transition": "all 0.3s"
              },
              "&:hover": {
                "img": {
                  "transform": "scale(1.2)",
                  "border-radius": "10%"
                },
                ".image-wrap": {
                  "transform": "scale(0.95)"
                },
                ".content-wrap": {
                  "padding-left": "1.5rem"
                },
