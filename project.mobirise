          "_name": "menu1",
          "_customHTML": "<section class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"4.5\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#121212\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/copia-de-variante6-koolstudio-hdtm-15-96x96.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"></a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Home</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"about-us.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">About Us</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"success-stories.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Success Stories</a></li><li class=\"nav-item dropdown\"><a class=\"nav-link link text-black text-primary dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">TikTok Marketing<br></a><div class=\"dropdown-menu\"><a class=\"text-black text-primary dropdown-item\" href=\"tiktok-marketing-partners.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">TikTok Partners</a><a class=\"text-black text-primary dropdown-item\" href=\"the-kool-methodology.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">The Kool Methodology</a></div></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"our-services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Services</a></li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-warning\" href=\"contact-us.html\" data-app-placeholder=\"Type Text\">Contact Us</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "s8WMQIZfEW",
          "_anchor": "menu1-1",
          "_sourceTheme": "designerm4",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "*": {
              "font-family": "'Poppins', sans-serif"
            },
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".team-card": {
              "margin-bottom": "2rem",
              "transition": "all 0.3s",
              "&:hover": {
                "transform": "translateY(-10px)"
              }
            },
            ".title-img": {
              "width": "290px",
              "height": "160px",
              "margin-bottom": "10px",
              "display": "inline-block",
              "object-fit": "contain",
              "@media (max-width: 576px)": {
                "width": "130px",
                "height": "70px",
                "margin-bottom": "5px",
                "display": "inline-block",
                "object-fit": "contain"
              }
            },
            ".social-row": {
              ".soc-item": {
                "display": "inline-block",
                "text-align": "center",
                "border-radius": "50%",
                "margin-right": "0.5rem",
                "margin-bottom": "1rem",
                "padding": "0.5rem",
                "height": "2.5rem",
                "width": "2.5rem",
                ".mbr-iconfont": {
                  "color": "@socialIconColor",
                  "transition": "all 0.3s",
                  "&:hover": {
                    "color": "@primaryColor"
                  }
                }
              }
            },
            ".image-wrap": {
              "&:hover, &:focus": {
                "img": {
                  "border-radius": "15% !important"
                },
                "&::after": {
                  "border-radius": "15%"
                }
              },
              "position": "relative",
              "img": {
                "width": "100%",
                "border-radius": "10% !important",
                "transition": "all 0.05s ease-in-out"
              },
              ".text-content": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background": "rgba(0, 0, 0, 0.5)",
                "color": "white",
                "display": "flex",
                "flex-direction": "column",
                "border-radius": "15% !important",
                "align-items": "center",
                "justify-content": "center",
                "opacity": "0",
                "transition": "opacity 0.1s ease-in-out",
                "p": {
                  "font-size": "25px",
                  "font-weight": "bold",
                  "color": "#ffdf58"
                }
              },
              "&:hover .text-content": {
                "opacity": "1"
              }
            },
            ".content-wrap": {
              "padding-top": "2rem"
            },
            ".mbr-role, .social-row": {
              "color": "#bbbbbb",
              "text-align": "left"
            },
            ".mbr-section-subtitle": {
              "color": "#bbbbbb",
              "font-weight": "600"
            },
            ".card-title, .social-row": {
              "color": "#121212"
            },
            ".mbr-section-text": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "team02",
          "_sourceTheme": "designerm4",
          "_customHTML": "<section class=\"team2\" group=\"Testimonials & Teams\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Sub Title\" name=\"showsubTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <header condition=\"showSocial\">Social</header>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#ffffff\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#131419\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-lg-8 col-md-12 pb-4\" mbr-if=\"showTitle || showText || showsubTitle\">\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style align-left pb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showsubTitle\" data-app-selector=\".mbr-section-subtitle\">\n                    ABOUT US</h4>\n                <h3 class=\"mbr-section-title mbr-fonts-style align-left mb-4\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>We are&nbsp;</b><img src=\"@PROJECT_PATH@/assets/images/logo-white-1.png\" alt=\"Kool Logo\" class=\"title-img\"></h3>\n                <p class=\"mbr-section-text mbr-fonts-style align-left mb-5\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text\">A creative house (creative agency + production house) based in Mexico, but with creative teams all over Latin America.\n\n<br><br>We do EVERYTHING from ads to documentaries, but we specialize in short-form content like TikToks and Reels for global companies.<br></p>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-sm-6\" mbr-class=\"{'col-lg-3': cardsAmount == 4, 'col-lg-4': cardsAmount != 4}\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/kari-2.webp\">\n                            <div class=\"text-content\">\n                            <p>I love \"gansitos\", </p>\n                            <p> dogs and dancing</p>\n                        </div>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Karina Rosas&nbsp;<br></h5>\n                        <h6 class=\"mbr-role mbr-fonts-style align-left mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>CEO and FOUNDER</b><br>Kari is the creative mastermind behind every<div>KOOL strategy.\n\n</div><div><br></div><br><div>And on her free time (?? if she&nbsp;<span style=\"font-size: 1.1rem;\">has any) she creates&nbsp;</span><span style=\"font-size: 1.1rem;\">marketing content on IG +&nbsp;</span><span style=\"font-size: 1.1rem;\">TikTok with over 500,000&nbsp;</span><span style=\"font-size: 1.1rem;\">followers.</span></div></h6>\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                            No special actions required, all sites you make with Mobirise are mobile-friendly.\n                        </p>\n                        <div class=\"social-row align-left display-7\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.tiktok.com/@kari.tips\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-tiktok socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                <a href=\"https://www.instagram.com/kari.tipsdemkt/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                <a href=\"https://www.instagram.com/kari.tipsdemkt/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"mbr-section-btn card-btn align-center\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">View\n                                Profile</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6\" mbr-class=\"{'col-lg-3': cardsAmount == 4, 'col-lg-4': cardsAmount != 4}\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/pepe-2.webp\" alt>\n                        <div class=\"text-content\">\n                            <p>Hi</p>\n                            <p>I'm Kool</p>\n                        </div>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"mbr-section-title card-title mbr-fonts-style m-0 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                            Jose Armando González&nbsp;</h5>\n                        <h6 class=\"mbr-role mbr-fonts-style align-left mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>PRODUCTION LEADER AND CO-FOUNDER</b><br>Film geek and believer in always having an innovative vision for branded content.<div><span style=\"font-size: 1.1rem;\"><br></span></div><br><div><span style=\"font-size: 1.1rem;\">He´s a TikTok and IG creator with&nbsp;</span><span style=\"font-size: 1.1rem;\">over 200,000 followers</span></div><div><div><br></div></div></h6>\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                            Use Mobirise website building software to create multiple sites for your clients.\n                        </p>\n                        <div class=\"social-row align-left display-7\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.tiktok.com/@pepegg33\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-tiktok socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                <a href=\"https://www.instagram.com/pepegg33/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                <a href=\"https://www.linkedin.com/in/pepegg33/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"mbr-section-btn card-btn align-center\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">View\n                                Profile</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6\" mbr-class=\"{'col-lg-3': cardsAmount == 4, 'col-lg-4': cardsAmount != 4}\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/team3-1.jpg\">\n                        <div class=\"text-content\">\n                            <p>Amo los gansitos, perritos y bailar</p>\n                            <p>Soy Kool</p>\n                        </div>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"mbr-section-title card-title mbr-fonts-style m-0 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                            Jessica Swift\n                        </h5>\n                        <h6 class=\"mbr-role mbr-fonts-style align-left mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                            DEVELOPER</h6>\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                            Create multiple pages. Don't forget to set links to your pages after creating them.\n                        </p>\n                        <div class=\"social-row align-left display-7\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"mbr-section-btn card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">View\n                                Profile</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6\" mbr-class=\"{'col-lg-3': cardsAmount == 4, 'col-lg-4': cardsAmount != 4}\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/team4.jpg\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"mbr-section-title card-title m-0 mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                            Helen Smith\n                        </h5>\n                        <h6 class=\"mbr-role mbr-fonts-style align-left mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                            Designer\n                        </h6>\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                            Each theme in the Mobirise site builder contains a set of unique blocks.\n                        </p>\n                        <div class=\"social-row align-left display-7\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"mbr-section-btn card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">View\n                                Profile</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "somos-kool",
          "_isUserblock": true,
          "_cid": "u7ZpVEGzVJ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider02",
          "_sourceTheme": "speakerm5",
          "_styles": {
            "*": {
              "font-family": "'Poppins', sans-serif"
            },
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 25px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 25px"
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "250px",
              "max-width": "250px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".item-wrapper": {
                "&:hover, &:focus": {
                  ".item-img": {
                    "img": {
                      "border-radius": "15% !important"
                    },
                    "&::after": {
                      "border-radius": "15%"
                    }
                  }
                },
                ".item-img": {
                  "position": "relative",
                  "display": "block",
                  "margin-bottom": "30px",
                  "img": {
                    "height": "370px",
                    "object-fit": "cover",
                    "transition": "all 0.05s ease-in-out",
                    "border-radius": "10% !important"
                  },
                  "&::after": {
                    "content": "''",
                    "font-size": "25px",
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "opacity": "0",
                    "width": "100%",
                    "height": "100%",
                    "background-color": "#000000",
                    "align-items": "center",
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "center",
                    "pointer-events": "none",
                    "transition": "all 0.1s ease-in-out"
                  },
                  "&:hover .text-content": {
                    "opacity": "1",
                    "transition": "opacity 0.1s ease-in-out"
                  }
                },
                ".text-content": {
                  "width": "100%",
                  "height": "100%",
                  "top": "0",
                  "left": "0",
                  "position": "absolute",
                  "display": "flex",
                  "justify-content": "center",
                  "align-items": "center",
                  "flex-direction": "column",
                  "background": "rgba(0, 0, 0, 0.6)",
                  "opacity": "0",
                  "transition": "opacity 0.1s ease-in-out",
                  "border-radius": "15% !important",
                  "p": {
                    "text-align": "center",
                    "font-size": "22px",
                    "margin-left": "20px",
                    "margin-right": "20px",
                    "font-weight": "bold",
                    "color": "#ffdf58",
                    "line-height": "1.2"
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "30%",
              "width": "52px",
              "height": "52px",
              "margin-top": "-1.5rem",
              "font-size": "32px",
              "background-color": "@activeBg !important",
              "opacity": "1 !important",
              "color": "@icon !important",
              "border": "none",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@icon",
                "opacity": ".7 !important"
              },
              "&.embla__button--prev": {
                "left": "-26px"
              },
              "&.embla__button--next": {
                "right": "-26px"
              },
              "@media (max-width: 992px)": {
                "bottom": "1.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "display": "none !important"
            },
            ".item-title": {
              "color": "#2f2e30"
            },
            ".mbr-text": {
              "color": "#bbbbbb"
            },
            ".mbr-name, .social-wrap": {
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section class=\"slider02 mbr-embla speakerm5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"color\" title=\"Active Color\" name=\"active\" value=\"#FFC394\">\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\">\n        <input type=\"color\" title=\"Role BG\" value=\"#ffe161\" name=\"role\" condition=\"showRole\" selected>\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"3\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"icon\" value=\"#ffffff\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Active BG\" name=\"activeBg\" value=\"#ffe161\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#131419\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#eff3f3\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/camila.webp\" alt=\"Camila Aguilar\">\n                                            <div class=\"text-content\">\n                                                <p>I make rankings of traditional food and desserts when I travel to new countries</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-content\">\n                                        <div class=\"role-wrap\">\n                                            <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-role, .role-wrap\" mbr-if=\"showRole\">\n                                                Founder and CEO\n                                            </p>\n                                        </div>\n                                        <h4 class=\"mbr-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-name, .social-wrap\" mbr-if=\"showName\">\n                                            <b>Camila Aguilar</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">\n                                            ACCOUNT MANAGER</p>\n                                    \n                                        <div class=\"social-wrap\">\n                                            <div class=\"social-row\" mbr-if=\"showSocial\">\n                                                <div class=\"soc-item\">\n                                                    <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                                    <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                                    <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/daniela-lugo-pic.webp\" alt=\"Daniela Lugo\">\n                                            <div class=\"text-content\">\n                                                <p>My nickname \"Cachito\" came about because I really like Lety Cachitos 😌 (mini cupcakes from a royal pastry shop)</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-content\">\n                                        <div class=\"role-wrap\">\n                                            <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-role, .role-wrap\" mbr-if=\"showRole\">\n                                                Business Strategist\n                                            </p>\n                                        </div>\n                                        <h4 class=\"mbr-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-name, .social-wrap\" mbr-if=\"showName\"><b>Dani Lugo</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">ACCOUNT MANAGER</p>\n                                        <div class=\"social-wrap\">\n                                            <div class=\"social-row\" mbr-if=\"showSocial\">\n                                                <div class=\"soc-item\">\n                                                    <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                                    <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                                    <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/daniela-reyes.webp\" alt=\"Daniela Reyes\">\n                                            <div class=\"text-content\">\n                                                <p>\n\nDiscovery Home and Health Fan</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-content\">\n                                        <div class=\"role-wrap\">\n                                            <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-role, .role-wrap\" mbr-if=\"showRole\">\n                                                VP of Marketing\n                                            </p>\n                                        </div>\n                                        <h4 class=\"mbr-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-name, .social-wrap\" mbr-if=\"showName\">\n                                            <b>Daniela Reyes</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">\n                                            TIKTOK PERFORMANCE MARKETING LEAD</p>\n                                        <div class=\"social-wrap\">\n                                            <div class=\"social-row\" mbr-if=\"showSocial\">\n                                                <div class=\"soc-item\">\n                                                    <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                                    <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                                    <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/alex.webp\" alt=\"Alex Gadea\">\n                                            <div class=\"text-content\">\n                                                <p>I danced at Pal Norte 2013 on stage with Vanilla Ice in front of 10,000 people</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-content\">\n                                        <div class=\"role-wrap\">\n                                            <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-role, .role-wrap\" mbr-if=\"showRole\">\n                                                Co-founder\n                                            </p>\n                                        </div>\n                                        <h4 class=\"mbr-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-name, .social-wrap\" mbr-if=\"showName\"><b style=\"font-size: 1.2rem;\">Alex Gadea</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">ART LEAD</p>\n                                        <div class=\"social-wrap\">\n                                            <div class=\"social-row\" mbr-if=\"showSocial\">\n                                                <div class=\"soc-item\">\n                                                    <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                                    <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                                    <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/marcelo.webp\" alt=\"Marcelo\">\n                                            <div class=\"text-content\">\n                                                <p>I like to write fantasy novels</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-content\">\n                                        <div class=\"role-wrap\">\n                                            <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-role, .role-wrap\" mbr-if=\"showRole\">\n                                                Investor\n                                            </p>\n                                        </div>\n                                        <h4 class=\"mbr-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-name, .social-wrap\" mbr-if=\"showName\">\n                                            <b>Marcelo</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">\n                                            PRODUCTION INTERN</p>\n                                        <div class=\"social-wrap\">\n                                            <div class=\"social-row\" mbr-if=\"showSocial\">\n                                                <div class=\"soc-item\">\n                                                    <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                                    </a>\n                                                </div>\n                                                <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                                    <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                