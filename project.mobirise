em;\n  margin: 0; }\n\nform .form-check-input {\n  margin-top: .5; }\n\ntextarea.form-control {\n  line-height: 1.5rem !important; }\n\n.form-group {\n  margin-bottom: 1.2rem; }\n\n.form-control,\nform .btn {\n  min-height: 48px; }\n\n.mbr-overlay {\n  background-color: #000;\n  bottom: 0;\n  left: 0;\n  opacity: 0.5;\n  position: absolute;\n  right: 0;\n  top: 0;\n  z-index: 0;\n  pointer-events: none; }\n\nblockquote {\n  font-style: italic;\n  padding: 3rem;\n  font-size: 1.09rem;\n  position: relative;\n  border-left: 3px solid; }\n\nul,\nol,\npre,\nblockquote {\n  margin-bottom: 2.3125rem; }\n\npre {\n  background: #f4f4f4;\n  padding: 10px 24px;\n  white-space: pre-wrap; }\n\n.inactive {\n  user-select: none;\n  pointer-events: none;\n  user-drag: none; }\n\n.mbr-section__comments .row {\n  justify-content: center; }\n\n.mt-4 {\n  margin-top: 2rem !important; }\n\n.mb-4 {\n  margin-bottom: 2rem !important; }\n\n@media (min-width: 992px) {\n  .row {\n    margin-left: -16px;\n    margin-right: -16px; }\n    .row > [class*=\"col\"] {\n      padding-left: 16px;\n      padding-right: 16px; } }\n@media (min-width: 768px) {\n  .container-fluid {\n    padding-left: 32px;\n    padding-right: 32px; } }\n@media (min-width: 768px) and (max-width: 991px) {\n  .mbr-container {\n    padding-left: 32px;\n    padding-right: 32px; } }\n@media (max-width: 767px) {\n  .mbr-container {\n    padding-left: 16px;\n    padding-right: 16px; } }\n.card-wrapper,\n.item-wrapper {\n  overflow: hidden; }\n\n.app-video-wrapper > img {\n  opacity: 1; }\n\n/*# sourceMappingURL=style.css.map */\n"
